{
  "name": "obsidian-mobile-optimizer",
  "version": "1.0.0",
  "description": "Diagnose which plugins hurt mobile performance and generate a mobile-safe config folder.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "obsidian": "latest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts",
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^obsidian$": "<rootDir>/tests/__mocks__/obsidian.ts"
    },
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "fast-check": "^3.19.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
